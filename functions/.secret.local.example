# Secretos para el emulador de Cloud Functions.
#
# Copia este archivo a `functions/.secret.local` y pega tus claves. Ese nombre
# es el que lee el emulador de Firebase para resolver los `defineSecret` sin
# tener que subir nada a Secret Manager.
#
# `.secret.local` está en .gitignore. Este ejemplo no, porque no lleva claves.

# https://console.anthropic.com  →  necesaria para el agente de informes
ANTHROPIC_API_KEY=sk-ant-...

# https://console.cloud.google.com  →  habilita "Custom Search API" y crea una clave
GOOGLE_SEARCH_API_KEY=AIza...

# https://programmablesearchengine.google.com  →  crea un motor con
# "Buscar en toda la web" activado y copia su ID (el cx)
GOOGLE_SEARCH_CX=a1b2c3d4e5f6g7h8i
