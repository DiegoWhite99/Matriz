rules_version = '2';

// Cada informe pertenece a la sesión que lo generó. Nadie lee los de otro,
// y nadie puede crear un documento atribuido a un uid ajeno.
service cloud.firestore {
  match /databases/{database}/documents {

    match /informes/{informeId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.markdown is string
                    && request.resource.data.markdown.size() < 200000
                    && request.resource.data.casoId is string
                    && request.resource.data.tipo in ['ejecutivo', 'tecnico', 'comparativo'];

      // Un informe es un registro de lo que se decidió: no se reescribe.
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
