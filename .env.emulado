# Modo emulador: todo corre en tu máquina.
#
#   npm run emuladores    (en una terminal)
#   npm run dev:emulado   (en otra)
#
# No hace falta cuenta de Firebase, ni proyecto, ni plan Blaze. El cliente usa
# una configuración ficticia y se conecta a los emuladores locales.
#
# Las claves de API van en functions/.secret.local, que el emulador lee y que
# .gitignore excluye. Nunca en este archivo: esto se commitea.

VITE_USE_EMULATORS=true
VITE_FUNCTIONS_REGION=us-central1
