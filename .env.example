# Configuración de Firebase para el cliente.
# Copia este archivo a `.env.local` y pega los valores de
# Consola de Firebase → Configuración del proyecto → Tus apps → Configuración del SDK.
#
# Estos valores son públicos por diseño: viajan en el bundle del navegador.
# La seguridad está en firestore.rules, no en ocultarlos.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Debe coincidir con la región de setGlobalOptions en functions/src/index.ts
VITE_FUNCTIONS_REGION=us-central1

# Las claves de API NO van aquí: son secretos del servidor. Se cargan con
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set GOOGLE_SEARCH_API_KEY
#   firebase functions:secrets:set GOOGLE_SEARCH_CX
